{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "baseUrl": "./src",
    "outDir": "./dist"
  },
  "include": ["./src/**/*.ts"]
}
